  "notice": "Templates only. Enter your own authorized SSH/Xray server details. No VPN credentials or public relay servers are included.",
  "sshModes": [
    {
      "id": "direct_tcp",
      "name": "Direct SSH",
      "description": "Connect directly to the SSH server."
    },
    {
      "id": "http_payload_direct",
      "name": "HTTP Payload",
      "description": "Send an HTTP CONNECT-style payload to the SSH endpoint."
    },
    {
      "id": "http_payload_proxy",
      "name": "HTTP Payload via Proxy",
      "description": "Connect to an HTTP proxy, then send the configured payload to the SSH server."
    },
    {
      "id": "tls_payload_direct",
      "name": "TLS + SNI Direct",
      "description": "Establish TLS to the SSH endpoint using SNI, then send the configured HTTP payload."
    },
    {
      "id": "tls_payload_proxy",
      "name": "TLS + Payload",
      "description": "Establish TLS using SNI, then send the HTTP payload."
    }
  ],
  "payloadTemplates": [
    {
      "id": "http_connect",
      "name": "HTTP CONNECT",
      "mode": "http_payload_direct",
      "payload": "CONNECT [host_port] HTTP/1.1\\r\\nHost: [host_port]\\r\\nProxy-Connection: Keep-Alive\\r\\nUser-Agent: KupalVPN/1.0\\r\\n\\r\\n"
    },
    {
      "id": "http_connect_keepalive",
      "name": "HTTP CONNECT (Keep-Alive)",
      "mode": "http_payload_proxy",
      "payload": "CONNECT [host_port] HTTP/1.1\\r\\nHost: [host]\\r\\nConnection: Keep-Alive\\r\\nProxy-Connection: Keep-Alive\\r\\nUser-Agent: KupalVPN/1.0\\r\\n\\r\\n"
    },
    {
      "id": "tls_http_connect",
      "name": "TLS + HTTP CONNECT",
      "mode": "tls_payload_proxy",
      "payload": "CONNECT [host_port] HTTP/1.1\\r\\nHost: [host_port]\\r\\nProxy-Connection: Keep-Alive\\r\\n\\r\\n"
    },
    {
      "id": "tls_http_connect_direct",
      "name": "TLS + HTTP CONNECT (Direct)",
      "mode": "tls_payload_direct",
      "payload": "CONNECT [host_port] HTTP/1.1\\r\\nHost: [host_port]\\r\\nProxy-Connection: Keep-Alive\\r\\n\\r\\n"
    }
  ],
